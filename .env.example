# ============================================================================
#  Database — Supabase (PostgreSQL)
#  Supabase Dashboard → tombol "Connect" di bagian atas proyek.
# ============================================================================

# Transaction pooler (port 6543) — dipakai aplikasi. WAJIB untuk Vercel (serverless).
# Tambahkan ?pgbouncer=true&connection_limit=5&pool_timeout=20 di akhir.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Session pooler (port 5432) — dipakai `prisma migrate deploy` saat build.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Pengembangan lokal dengan PostgreSQL biasa: isi keduanya dengan URL yang sama, mis.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spk"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/spk"

# ============================================================================
#  Supabase Storage — logo client & gambar ilustrasi
#  Supabase Dashboard → Project Settings → API Keys. Kunci ini RAHASIA
#  (hanya di server, jangan pernah diberi awalan NEXT_PUBLIC_).
#  Kosongkan saat pengembangan lokal → berkas disimpan di UPLOAD_DIR.
# ============================================================================
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Nama bucket (privat, dibuat otomatis bila belum ada)
SUPABASE_STORAGE_BUCKET="spk-uploads"
# Folder unggahan lokal (hanya dipakai bila Supabase Storage tidak diisi)
UPLOAD_DIR="./storage/uploads"

# ============================================================================
#  Autentikasi (NextAuth)
# ============================================================================
# Kunci rahasia sesi — WAJIB diganti. Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-yang-panjang"
# URL aplikasi. Di Vercel boleh dikosongkan untuk preview; isi dengan domain
# produksi untuk deployment produksi.
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
#  URL publik untuk tag Open Graph (gambar & tautan pratinjau)
#  Isi dengan domain produksi, mis. https://spk.domainanda.id
#  Bila kosong di Vercel, domain produksi Vercel dipakai otomatis.
# ============================================================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Zona waktu tampilan tanggal (IANA): Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

# ============================================================================
#  Ekspor PDF — hanya untuk komputer lokal.
#  Di Vercel, Chromium serverless (@sparticuz/chromium) dipakai otomatis.
#  Lokal: kosongkan untuk mencari Chrome/Edge yang terpasang secara otomatis.
# ============================================================================
PUPPETEER_EXECUTABLE_PATH=""
# "true" bila Chrome lokal berjalan di container / sebagai root
PUPPETEER_NO_SANDBOX="false"

# ============================================================================
#  Data awal (npm run db:seed)
# ============================================================================
SEED_SUPERADMIN_EMAIL="superadmin@spk.local"
SEED_SUPERADMIN_PASSWORD="SuperAdmin#2026"
# "false" agar seed hanya membuat akun Super Admin (tanpa data contoh)
SEED_DEMO="true"
